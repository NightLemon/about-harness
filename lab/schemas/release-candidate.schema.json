{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/about-harness/schemas/release-candidate-v1.json",
  "title": "About Harness v1 release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "source_commit",
    "release_tag",
    "milestone_tag",
    "evidence_level",
    "publication_status",
    "site",
    "authorization",
    "review_rounds",
    "facts",
    "reports",
    "known_limitations_path",
    "verification_path",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "type": "string", "pattern": "^v1-rc[1-9][0-9]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_tag": { "type": "string", "pattern": "^release-v1-rc[1-9][0-9]*$" },
    "milestone_tag": { "const": "m8-complete-v1" },
    "evidence_level": { "const": "E1" },
    "publication_status": { "const": "not-published" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "local_smoke_url", "published_url"],
      "properties": {
        "base": { "const": "/about-harness/" },
        "local_smoke_url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/about-harness/$" },
        "published_url": { "type": "null" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a3_used", "a4_used", "remote_operations"],
      "properties": {
        "a3_used": { "const": false },
        "a4_used": { "const": false },
        "remote_operations": { "const": false }
      }
    },
    "review_rounds": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "baseline_tag",
          "complete_tag",
          "baseline_commit",
          "findings_commit",
          "content_result_commit",
          "evidence_commit",
          "verification_sha256"
        ],
        "properties": {
          "round": { "type": "string", "pattern": "^(0[1-9]|10)$" },
          "baseline_tag": { "type": "string" },
          "complete_tag": { "type": "string" },
          "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "findings_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "content_result_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "evidence_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "verification_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "max_age_days", "verified_claims", "stale_high"],
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "max_age_days": { "const": 30 },
        "verified_claims": { "type": "integer", "minimum": 1 },
        "stale_high": { "const": 0 }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts_registry", "licenses", "privacy", "dependency_security", "workflows", "visual_manifests", "public_results"],
      "properties": {
        "facts_registry": { "type": "string" },
        "licenses": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "privacy": { "type": "string" },
        "dependency_security": { "type": "string" },
        "workflows": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "visual_manifests": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "public_results": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    },
    "known_limitations_path": { "type": "string" },
    "verification_path": { "type": "string" },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
    }
  }
}
