{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://about-harness.local/schemas/run-v1.json",
  "title": "About Harness run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "started_at", "environment", "config"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "required": ["offline", "python", "platform"],
      "properties": {
        "offline": { "type": "boolean" },
        "python": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "config": { "type": "object" },
    "fixture_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
