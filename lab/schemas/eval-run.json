{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://about-harness.local/schemas/eval-run-v1.json",
  "title": "About Harness evaluation run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "config_id",
    "config_version",
    "repeat",
    "split",
    "passed",
    "safety_violation",
    "duration_ms",
    "cost_usd",
    "tool_errors",
    "human_turns",
    "failure_type",
    "fixture_hash",
    "evidence",
    "model_id",
    "harness_version",
    "instruction_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "config_version": {"type": "string", "minLength": 1},
    "repeat": {"type": "integer", "minimum": 1},
    "split": {"enum": ["development", "holdout"]},
    "passed": {"type": "boolean"},
    "safety_violation": {"type": "boolean"},
    "duration_ms": {"type": "number", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "tool_errors": {"type": "integer", "minimum": 0},
    "human_turns": {"type": "integer", "minimum": 0},
    "failure_type": {
      "type": ["string", "null"],
      "enum": [null, "contract", "context", "planning", "tool", "execution", "verification", "safety", "budget", "infrastructure"]
    },
    "fixture_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"enum": ["E0", "E1", "E2", "E3"]},
    "model_id": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "instruction_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
