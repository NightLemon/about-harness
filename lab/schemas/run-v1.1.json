{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution envelope v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "started_at",
    "fixture_hash",
    "config",
    "environment",
    "artifacts",
    "cleanup",
    "execution_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "fixture_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object"
    },
    "environment": {
      "type": "object",
      "required": [
        "offline",
        "python",
        "platform",
        "source_commit",
        "runtime_source_hashes"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "task",
        "trace",
        "result",
        "config",
        "fixture"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "temporary_repository_removed"
      ],
      "properties": {
        "temporary_repository_removed": {
          "const": true
        }
      }
    },
    "execution_artifacts": {
      "type": "object",
      "required": [
        "workspace.json",
        "baseline-test.json"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
