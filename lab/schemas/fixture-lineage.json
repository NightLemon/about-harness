{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://about-harness.local/schemas/fixture-lineage-v1.json",
  "title": "About Harness immutable fixture lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "refs"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "task_id", "commit", "path", "fixture_hash"],
        "properties": {
          "ref_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "task_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "path": { "type": "string", "pattern": "^lab/fixtures/[a-z0-9-]+$" },
          "fixture_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
