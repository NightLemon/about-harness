{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://about-harness.local/schemas/result-v1.json",
  "title": "About Harness result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "status", "stop_reason", "metrics", "trace"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "stopped", "failed"] },
    "stop_reason": {
      "enum": ["completed", "max_steps", "model_budget", "timeout", "cancelled", "permission_denied", "tool_error", "invalid_action"]
    },
    "output": {},
    "metrics": {
      "type": "object",
      "required": ["steps", "model_calls", "tool_calls", "reused_tool_calls", "duration_ms", "cost_usd"],
      "properties": {
        "steps": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "reused_tool_calls": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "trace": { "type": "array" },
    "checkpoint": { "type": ["object", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
