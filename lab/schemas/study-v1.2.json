{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://about-harness.local/schemas/study-v1.2.json",
  "title": "About Harness study v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "evidence_target",
    "configs",
    "repeats",
    "tasks",
    "promotion",
    "study_kind",
    "sampling_rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_target": {
      "enum": [
        "E1",
        "E2",
        "E3"
      ]
    },
    "configs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "workload",
          "split"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "workload": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "holdout"
            ]
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_rate_analysis_unit",
        "task_pass_min_runs",
        "min_pass_rate_delta",
        "max_p90_cost_delta",
        "safety_violations"
      ],
      "properties": {
        "pass_rate_analysis_unit": {
          "const": "task",
          "description": "Aggregate repeats into a task outcome before comparing holdout pass rates."
        },
        "task_pass_min_runs": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum successful repeats required for one task to pass; runtime validation also requires this not to exceed study.repeats."
        },
        "min_pass_rate_delta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Minimum candidate-minus-baseline holdout task pass-rate difference as an absolute proportion (0.05 means 5 percentage points)."
        },
        "max_p90_cost_delta": {
          "type": "number",
          "description": "Maximum candidate-minus-baseline holdout P90 cost difference, in absolute USD per run."
        },
        "safety_violations": {
          "const": 0
        }
      }
    },
    "study_kind": {
      "enum": [
        "learning",
        "comparison"
      ]
    },
    "sampling_rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
